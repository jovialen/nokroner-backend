<div>
  <h1>Register</h1>

  <%= form_with url: api_v1_register_path, method: :post, scope: :user do |f| %>
    <div>
      <%= f.label :email_address, "Email Address" %>
      <%= f.email_field :email_address, required: true, autofocus: true %>
    </div>

    <%= f.fields_for :profile_attributes do |pf| %>
      <div>
        <%= pf.label :first_name, "First name" %>
        <%= pf.text_field :first_name, required: true %>
      </div>

      <div>
        <%= pf.label :last_name, "Last name" %>
        <%= pf.text_field :last_name, required: true %>
      </div>

      <div>
        <%= pf.label :date_of_birth, "Date of birth" %>
        <%= pf.date_field :date_of_birth, required: true %>
      </div>
    <% end %>

    <div>
      <%= f.label :password, "Password" %>
      <%= f.password_field :password, required: true %>
    </div>

    <div>
      <%= f.label :password_confirmation, "Confirm Password" %>
      <%= f.password_field :password_confirmation, required: true %>
    </div>

    <%= f.submit "Register" %>
    <%= link_to "Back", home_path %>
  <% end %>

  <p>
    Already have an account? <%= link_to "Log in here", login_path %>
  </p>
</div>