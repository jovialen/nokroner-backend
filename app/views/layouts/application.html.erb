<!DOCTYPE html>
<html>
  <head>
    <title>Nokroner Backend</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>

    <style>
      * {
          box-sizing: border-box;
          font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
      }

      body {
          padding: 0;
          margin: 0;
      }
    </style>
  </head>

  <body>
    <% if flash[:alert] %>
      <div><%= flash[:alert] %></div>
    <% end %>
    <% if flash[:notice] %>
      <div><%= flash[:notice] %></div>
    <% end %>

    <%= yield %>
  </body>
</html>